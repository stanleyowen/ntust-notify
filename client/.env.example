# API origin. Leave empty in development to use Vite's /api proxy
# (→ http://localhost:3000). Also added to the CSP connect-src at build time.
VITE_API_URL=https://api.example.com

# Firebase web config (Firebase Console → Project settings → Your apps).
# Only Authentication is used by the browser; Firestore is server-only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Set to true to ship the Content-Security-Policy as report-only (for
# validating a new deployment). Leave unset for enforcement.
# VITE_CSP_REPORT_ONLY=true
