# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Interface to listen on. Default 127.0.0.1 (only the local reverse proxy /
# tunnel can reach the API). Use 0.0.0.0 only when clients connect directly.
# The Docker image sets 0.0.0.0 itself; exposure is then set by BIND_ADDR.
# HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API (exact match).
# Don't leave localhost origins in production.
ALLOWED_ORIGINS=https://notify.stanleyowen.com,https://ntust.netlify.app

# Number of reverse-proxy hops in front of this server (nginx, Caddy,
# Cloudflare, …) — used to find the real client IP for rate limiting.
# 0 = clients connect directly. Setting this higher than reality lets clients
# spoof X-Forwarded-For.
TRUST_PROXY=1

# docker-compose only: interface to publish the port on. Default 127.0.0.1
# (reachable only through a reverse proxy on the same host).
# BIND_ADDR=127.0.0.1

# ── Polling ─────────────────────────────────────────────────────────────────
# Verified Google accounts allowed the 1-second check interval (everyone
# else's minimum is 30 s). Checked against the Firebase Auth record, not
# anything the user can edit.
AUTH_EMAILS=you@example.com

# Max concurrent NTUST requests per poll cycle (1–32). Default 8.
POLL_FETCH_CONCURRENCY=8

# Max courses per user's watchlist (1–200). Default 30.
MAX_WATCHED_PER_USER=30

# Alerts switch themselves off this many days after being turned on (1–365).
# Turning alerts on again restarts the countdown. Default 30.
ALERT_DURATION_DAYS=30

# ── Firebase Admin SDK ──────────────────────────────────────────────────────
# Option A: path to the service-account JSON (docker-compose mounts it at
# /run/secrets/service-account.json and sets this for you).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option B: the whole service-account JSON on one line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# STARTTLS is required when SMTP_SECURE=false (credentials never go out in
# plaintext). Gmail: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="NTUST Notify <you@gmail.com>"
